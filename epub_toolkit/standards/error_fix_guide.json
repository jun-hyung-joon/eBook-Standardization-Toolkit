    "metadata": {
      "title": "EPUB 3.3 Error Fix Precision Guide (Searchable Text Edition)",
      "description": "Text-only fallback strategy. All automatic fixes inject the tag '[AUTO-FIX]' for easy searchability by the creator.",
      "version": "8.0.0",
      "updated": "2025-11-26"
    },
    "global_rules": {
      "philosophy": "Practicality & Traceability. No image generation. Replace errors with visible text markers containing '[AUTO-FIX]' so creators can find them easily.",
      "action_priority": "1. Format Repair. 2. Content Preservation (Unwrap). 3. Text Substitution (Marker). 4. Comment Injection.",
      "cascade_logic": "Deep Clean: When a resource is removed, replace references with a text span: <span class='auto-fix-marker'>[AUTO-FIX] Resource Removed</span>.",
      "search_tag": "All injected text or comments MUST include '[AUTO-FIX]'."
    },
