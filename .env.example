# =============================================================================
# EPUB Standardization AI Toolkit environment variables - EPUBCheck only
# Ace by DAISY related settings removed
# =============================================================================

# =============================================================================
# AI API keys (at least one required)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-your-actual-claude-key-here
OPENAI_API_KEY=sk-your-actual-openai-key-here
GOOGLE_API_KEY=your-actual-google-gemini-key-here
XAI_API_KEY=xai-your-actual-grok-key-here

# =============================================================================
# Default AI settings
# =============================================================================
DEFAULT_AI_MODEL=claude                # Default AI provider (claude, gpt, gemini, grok)
MAX_RETRIES=3                          # Maximum retry attempts
API_TIMEOUT=120                        # API timeout (seconds)

# =============================================================================
# EPUB tool paths (usually not required to change - auto-install available)
# =============================================================================
# EPUBCheck settings
EPUBCHECK_JAR=~/.epub_toolkit/epubcheck/epubcheck.jar
EPUBCHECK_AUTO_INSTALL=true           # Auto-install EPUBCheck
EPUBCHECK_AUTO_UPDATE=true            # Auto-update EPUBCheck

# Java options
JAVA_OPTS=-Xmx2g                       # Java heap memory settings

# =============================================================================
# Processing settings
# =============================================================================
TARGET_STANDARD=EPUB 3.3               # Target EPUB standard
MAX_FILE_SIZE_MB=500                   # Maximum file size (MB)
MAX_ITERATIONS=5                       # Maximum improvement iterations
BACKUP_ENABLED=true                    # Create backup of original
LANGUAGE=auto                          # Language setting
TIMEZONE=Asia/Seoul                    # Timezone setting

# =============================================================================
# Output settings
# =============================================================================
OUTPUT_SUFFIX=_standardized            # Output filename suffix
REPORT_FORMAT=json                     # Report format (json, html)
VALIDATE_OUTPUT=true                   # Validate output file
GENERATE_REPORT=true                   # Generate report

# =============================================================================
# Logging settings
# =============================================================================
LOG_LEVEL=INFO                         # Log level (DEBUG, INFO, WARNING, ERROR)
QUIET_MODE=false                       # Quiet mode

# =============================================================================
# Temporary directory
# =============================================================================
TEMP_DIR=/tmp/epub_toolkit             # Temporary working directory
CLEANUP_TEMP=true                      # Auto-clean temporary files

# =============================================================================
# GitHub API (optional)
# =============================================================================
# Use to avoid rate limits when auto-downloading EPUBCheck
# GITHUB_TOKEN=ghp_your_token_here

# =============================================================================
# Usage:
# 1. Copy this file to .env: cp .env.example .env
# 2. Replace API keys with real values
# 3. Adjust only the settings you need to change
# =============================================================================